# Copy this file to `.env` or `.env.local` and adjust values for your environment.
#
# IMPORTANT:
# - Never commit real secrets (tokens, API keys) to git.
# - CRA only exposes variables prefixed with REACT_APP_.

# Backend API base URL
REACT_APP_API_URL=https://your-railway-app.railway.app/api

# API request timeout in milliseconds
REACT_APP_API_TIMEOUT=10000

# Storage key used for persisting auth tokens in localStorage
REACT_APP_TOKEN_KEY=auth_token

# App metadata (display only)
REACT_APP_APP_NAME=MyApp
REACT_APP_VERSION=1.0.0
