generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Credential {
  id            String   @id @default(uuid())
  userId        String
  provider      String
  encryptedKey  String
  keyName       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider, keyName])
  @@index([userId])
}
